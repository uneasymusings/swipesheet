{
  "name": "swipesheet",
  "version": "0.1.0",
  "description": "Contact sheets, but swipeable: native macOS image review for AI-assisted projects.",
  "license": "MIT",
  "author": "Ricardo Andoni",
  "homepage": "https://github.com/uneasymusings/swipesheet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uneasymusings/swipesheet.git"
  },
  "bugs": {
    "url": "https://github.com/uneasymusings/swipesheet/issues"
  },
  "bin": {
    "swipesheet": "./bin/swipesheet.js",
    "image-picker": "./bin/swipesheet.js"
  },
  "scripts": {
    "assets:demo": "node ./scripts/render-demo-gif.js",
